language = {eng},
address = {New York},
author = {Karnalim, Oscar and Toba, Hapnes and Johan, Meliana Christianti},
keywords = {Academic misconduct ; AI assistance misuse ; Artificial intelligence ; ChatGPT ; Cheating ; Code anomaly ; Computer Appl. in Social and Behavioral Sciences ; Computer programming ; Computer Science ; Computers and Education ; Education ; Educational aspects ; Educational Technology ; Information Systems Applications (incl.Internet) ; Introductory programming ; Plagiarism ; Programming ; Python ; Sensors ; Study and teaching ; User Interfaces and Human Computer Interaction},
