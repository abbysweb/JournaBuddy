# JournaBuddy Environment Variables
# Copy this file to .env and fill in your API keys.

# LLM Providers (try NVIDIA first, fallback to Gemini -> OpenAI -> Ollama)
NVIDIA_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# External API Tokens
TU_WIEN_API_TOKEN=

# Optional overrides
MODEL_NAME=deepseek-ai/deepseek-v4-flash
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
USE_GEMINI=true
OLLAMA_URL=http://host.docker.internal:11434
